# PostgreSQL (Neon recommended) — pooled + direct (Prisma needs both)
# From Neon dashboard: copy "Pooled" and "Direct" connection strings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key

# Site URL (for NextAuth callbacks and password-reset links)
# Local: http://localhost:3000
# Production (Vercel): https://www.kuzu.fm — set this in Vercel env vars
NEXTAUTH_URL=http://localhost:3000

# Facebook Login — create an app at https://developers.facebook.com/
# Valid OAuth redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Listener stats (Kuzu Stats charts + listening hours): to accumulate data
# locally, keep ICECAST_STATUS_URL set AND ENABLE_CRON=true (the default) so the
# 5-min poll runs. Without both, /kuzu-stats shows "No listener data in this
# time range."
# Also used by GET /api/tracking/current-track for live now-playing metadata.
# Cron / local listener poll also logs Icecast title changes into tracklist.
# Use stream.kuzu.fm (raw IP may time out from Vercel/home networks).
# ICECAST_STATUS_URL=http://stream.kuzu.fm:8000/status-json.xsl

# Optional: disable background cron (listener poll, auto-start schedules)
# ENABLE_CRON=true

# Optional: listener poll interval in ms (default 300000 = 5 min)
# LISTENER_POLL_MS=300000

# Vercel Cron auth for /api/cron/listeners (Vercel sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=

# Radio Logik → POST /api/tracking/insert armed Go Live (`label` contains <><>).
# Required for auto-start activation; send Authorization: Bearer <TRACKING_INSERT_SECRET>.
# Without this, track rows are still logged but armed shows are not taken live.
# TRACKING_INSERT_SECRET=

# TipTap editor image uploads (Vercel: connect Blob store → adds BLOB_STORE_ID automatically)
# Local dev uses public/uploads/editor without Blob env vars
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=  (legacy fallback; optional if OIDC is enabled)

# Password reset emails (Resend — https://resend.com)
# Without RESEND_API_KEY, reset links are logged to the server console in development.
# RESEND_API_KEY=
# EMAIL_FROM="KUZU <noreply@yourdomain.com>"
