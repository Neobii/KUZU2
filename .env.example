# PostgreSQL (Neon recommended) — pooled + direct (Prisma needs both)
# From Neon dashboard: copy "Pooled" and "Direct" connection strings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key

# Site URL (for NextAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# Facebook Login — create an app at https://developers.facebook.com/
# Valid OAuth redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Optional: Icecast status JSON (listeners + radio-logik health)
# ICECAST_STATUS_URL=http://138.197.2.189:8000/status-json.xsl

# Optional: disable background cron (listener poll, auto-start schedules)
# ENABLE_CRON=false

# Optional: listener poll interval in ms (default 300000 = 5 min)
# LISTENER_POLL_MS=300000

# Password reset emails (Resend — https://resend.com)
# Without RESEND_API_KEY, reset links are logged to the server console in development.
# RESEND_API_KEY=
# EMAIL_FROM="KUZU <noreply@yourdomain.com>"
